# ATO Shield v2 - Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ato_shield

# API Security
API_SECRET_KEY=your-secret-key-here-change-in-production

# Bank API (for demo/pilot)
BANK_API_KEY=ask_live_xxxxxxxxxxxxxxxxxxxx
BANK_WEBHOOK_URL=https://yourbank.com/ato-decisions
BANK_ID=BANK_HDFC_001

# WebSocket
WS_SECRET=your-ws-secret-here

# Environment
ENVIRONMENT=development
